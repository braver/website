---
layout: layout.njk
title: Instant color studies
description: This is a collection of color studies on aged or otherwise problematic polaroids.
---

<div class="swipe slideshow" id="swipe">
	<div class="swipe-wrap">
		{% include "_cover.njk" %}

		{% for pic in collections.polaroid -%}
		    <div class='slide'><span class="title">{{ pic.name }}</span><img alt='{{ pic.name }}' src='/photo/polaroid/{{ pic.key }}-1920.jpg' srcset='/photo/polaroid/{{ pic.key }}-750.jpg 878w, /photo/polaroid/{{ pic.key }}-1920.jpg 2048w'></div>
		{% endfor %}

	</div>
</div>

{% include "_controls.njk" %}
